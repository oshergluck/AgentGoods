# Contract deployment configuration. Copy to `contracts/.env` and fill in.
#
#     cp .env.example .env
#
# `.env` is gitignored and the secret scanner will refuse a commit that contains a key, so the
# safe thing and the easy thing are the same thing here.
#
# Nothing in this file is ever sent anywhere. The deploy script reads it locally, signs locally,
# and talks only to the RPC endpoint you name below.

# ============================================================================ signing
# The ONLY private key in this file. It pays gas and it briefly holds full authority over the
# protocol, until `script/handoff.js` moves that authority to a timelock.
#
# Use a wallet created for this and nothing else. Not a personal wallet, not one that has ever
# signed an approval on a site you do not control.
DEPLOYER_PRIVATE_KEY=

# ============================================================================= network
# Base mainnet (8453) or Base Sepolia (84532). From Alchemy, Infura, QuickNode, or Base's public
# endpoint. The URL usually contains an API key, so treat this whole line as a secret.
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# From etherscan.io -> Account -> API Keys. Since Etherscan API V2 (V1 was deprecated on
# 2025-08-15) this is ONE key covering every supported chain, Base included — you no longer
# register separately on basescan.org. The chain is selected by a `chainid` query parameter,
# which the plugin adds for you.
#
# Required off LOCAL: `script/verify.js` throws without it, because unverified bytecode makes
# every "audit this yourself" instruction in the documentation impossible to follow.
ETHERSCAN_API_KEY=
# Legacy name, still accepted as a fallback so an older local .env keeps working.
BASESCAN_API_KEY=

# ============================================================================== roles
# Four addresses, four different jobs. PUBLIC addresses only — never a private key.
# See docs/GUARDIAN_TIMELOCK_MODEL.md for exactly what each one can and cannot do.

# Holds DEFAULT_ADMIN, UPGRADER, FEE_ADMIN and FACTORY_ADMIN until the handoff.
# Set this to the DEPLOYER's own address: `script/handoff.js` refuses to run unless the connected
# signer is the recorded bootstrap admin.
BOOTSTRAP_ADMIN_ADDRESS=

# Emergency stop. Can pause, cannot unpause, cannot upgrade, cannot withdraw anything.
# MUST NOT equal the deployer. The deployment gate refuses a deployment where they match, because
# "the key that can break it can also fix it" is not a safety design.
GUARDIAN_ADDRESS=

# Where protocol fees accumulate. This address only ever RECEIVES; it never signs anything during
# deployment, so it is the right place for a hardware wallet.
TREASURY_DESTINATION_ADDRESS=

# Publishes dividend Merkle roots, once per epoch per store. A warm operational key: it signs
# transactions periodically, forever, and is NOT retired by the handoff. Keep it separate from the
# deployer for exactly that reason — the deployer is meant to become worthless after handoff.
DIVIDEND_ROOT_PROPOSER_ADDRESS=

# ========================================================================== externals
# Base mainnet USDC. Verify this against an independent source before a mainnet deployment; it is
# the single address most worth getting right.
CANONICAL_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# UniswapV2-compatible router on Base.
DEX_ROUTER_ADDRESS=

# ============================================================================ handoff
# Only needed at Phase 8, after a clean 72-hour proving run. Left here so the whole picture is in
# one file. See docs/DEPLOY_WALKTHROUGH.md Phase 8.
#
# Comma-separated multisig signers. None may be the deployer or the guardian.
TIMELOCK_PROPOSERS=
# "ANYONE" lets any address execute a proposal once its delay has elapsed, which is safe and
# normal — the call is already public and already waited. Or give an explicit list.
TIMELOCK_EXECUTORS=ANYONE
# 48 hours. Long enough that an upgrade cannot land before anyone notices, short enough that a
# hostile pause is an outage rather than a catastrophe. See GUARDIAN_TIMELOCK_MODEL.md section 5.
TIMELOCK_MIN_DELAY_SECONDS=172800
