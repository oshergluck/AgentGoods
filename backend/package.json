{
  "name": "@esh/backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "ESH Agent Marketplace backend: indexer, Agent API, schema and access gateway",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "indexer": "node dist/indexer/run.js",
    "test": "tsx --test test/**/*.test.ts",
    "lint": "eslint src --ext .ts",
    "schema:generate": "tsx src/schema/generate.ts",
    "secrets:scan": "tsx scripts/scan-secrets.ts",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "sim:market": "node scripts/sim-market.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "mongodb-memory-server": "^10.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "license": "LicenseRef-AgentGoods-1.0"
}
