# ESH backend configuration. Copy to .env and fill in. NEVER commit a real .env.
# Production startup fails closed if any of these is missing or left at its default.

NODE_ENV=development
# Deployment stage, distinct from NODE_ENV: LOCAL | PROVING | CUTOVER | PRODUCTION
ESH_ENVIRONMENT=LOCAL

PORT=4000
HOST=0.0.0.0

# Chain and the generated protocol manifest (contracts/script/deploy.js writes it).
CHAIN_ID=31337
DEPLOYMENTS_DIR=../deployments

# RPC. A secondary is used ONLY for failover and reconciliation, never for normal reads.
RPC_HTTP_URL=http://127.0.0.1:8545
RPC_HTTP_URL_SECONDARY=
RPC_WS_URL=

MONGODB_URI=mongodb://127.0.0.1:27017/esh

# Indexer safety
SAFE_CONFIRMATIONS=12
MAX_REORG_DEPTH=64
INDEXER_STALE_BLOCKS=150
INDEXER_POLL_MS=2000
INDEXER_BACKFILL_CHUNK=2000
INDEXER_ENABLED=true

# ---------------------------------------------------------------------------- secrets
# Generate each one SEPARATELY. Reusing one value for two purposes means a leak of one is a
# leak of both.
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# PRODUCTION startup is refused while any of these is empty or still holds its dev default.
#
# WARNING, read before generating: two of these cannot be rotated without loss.
#   CONTENT_ENCRYPTION_KEY - content keys are derived from it. Changing it makes every product
#                            already uploaded permanently undecryptable. Not re-uploadable. Gone.
#   API_KEY_PEPPER         - also the root of every derived webhook signing secret. Changing it
#                            invalidates every issued API key and every webhook secret at once.
# Decide them once, and store them where you will still have them in a year.

# Hashes Agent API keys, and derives every webhook signing secret.
API_KEY_PEPPER=
# Encrypts delivered product content at rest (AES-256-GCM, per-content keys derived via HKDF).
CONTENT_ENCRYPTION_KEY=
# Signs single-use content delivery URLs.
ACCESS_TOKEN_KEY=

CHALLENGE_TTL_SECONDS=300

# Exact browser origins allowed to call authenticated endpoints. Never use "*".
CORS_ORIGINS=http://localhost:5173
# Number of trusted proxy hops. 0 means trust nothing. Railway behind Cloudflare is usually 2.
TRUST_PROXY_HOPS=0

# Canonical public URLs. Moltbook post generation refuses to run unless these are production.
PUBLIC_BASE_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:5173

# Rate limits per identity dimension per minute. Raise for proving, never disable.
RATE_LIMIT_GLOBAL_PER_MIN=600
RATE_LIMIT_CHALLENGE_PER_MIN=20
RATE_LIMIT_KEY_OPS_PER_MIN=10

# Object storage for paid content
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

LOG_LEVEL=info

# ---------------------------------------------------------------------------- moltbook
# Moltbook (https://www.moltbook.com) is a third-party social network for autonomous agents.
# This key is sent ONLY to the official Moltbook origin and nowhere else. Leave it empty and the
# integration is inert: it never polls, drafts or posts. Never commit a real value here.
MOLTBOOK_API_KEY=
# disabled | review | autonomous. review drafts replies for human approval; only autonomous may
# publish a reply without one. The launch post always requires the explicit publish-launch command
# regardless of mode.
MOLTBOOK_MODE=review
MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1
MOLTBOOK_AGENT_NAME=AgentGoodsAI
# The public site the moltbook-* scripts link to. Overrides PUBLIC_BASE_URL inside those scripts
# ONLY (see backend/scripts/moltbook-env.ts), so a dev .env pointing at localhost stays as it is.
MOLTBOOK_PUBLIC_BASE_URL=https://agentgoods.ai
TESTNET_PUBLIC_URL=https://testnet.agentgoods.ai
MOLTBOOK_DAILY_WRITE_BUDGET=20
MOLTBOOK_POLL_MS=300000
MOLTBOOK_AUTHOR_COOLDOWN_MINUTES=30
MOLTBOOK_MAX_THREAD_DEPTH=4
# Composes replies via a plain OpenAI chat-completion call (no tool use, no function calling —
# just text in, text out) when no fixed template matches an on-topic question. Off by default.
# Never sent anywhere but api.openai.com, and used ONLY for Moltbook reply drafting.
MOLTBOOK_LLM_DRAFTING_ENABLED=false
OPENAI_API_KEY=
MOLTBOOK_OPENAI_MODEL=gpt-5-mini
MOLTBOOK_OPENAI_TIMEOUT_MS=45000
MOLTBOOK_DAILY_INFERENCE_BUDGET=50
# Other agents' posts the loop should engage with (comma-separated Moltbook post ids): it replies
# once to each post itself and answers the comments under it. Never picked automatically.
MOLTBOOK_WATCHED_POSTS=
# Local ledger file (idempotency, loop-prevention, budget) — never AgentGoods' own MongoDB. Leave
# unset for the default (backend/.moltbook/ledger.sqlite, auto-created).
MOLTBOOK_LOCAL_DB_PATH=
